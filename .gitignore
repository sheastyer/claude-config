# This repo should only ever contain portable config. The list below is
# belt-and-suspenders: even if a secret or personal-state file is accidentally
# copied in here, git will refuse to track it.

# Secrets / auth
.credentials.json
*.credentials.json
.env
*.token

# Per-machine, not shared
settings.local.json

# Personal history / conversation state (never belongs in a shared repo)
history.jsonl
projects/
sessions/
todos/

# Backups created by install.sh, and OS cruft
*.backup.*
.DS_Store
